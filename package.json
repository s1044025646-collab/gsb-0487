{
  "name": "jones-propagation-backend",
  "version": "1.0.0",
  "description": "Jones 偏振元件顺序传播与复振幅/强度/Stokes 核验后端（API + CLI）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/cli.js serve",
    "demo": "node dist/src/cli.js demo",
    "cli": "node dist/src/cli.js",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
